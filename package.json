{
  "name": "@groundsgg/motd",
  "version": "0.1.0",
  "description": "Framework independent Minecraft server list editor, renderer and text codecs",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist",
    "assets",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "docs/api.md",
    "docs/formats.md",
    "docs/embedding.md",
    "docs/profiles.md",
    "docs/limitations.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./dom": {
      "types": "./dist/dom/index.d.ts",
      "import": "./dist/dom/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "build": "tsc && node tools/build-assets.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "dev": "vite --host 127.0.0.1",
    "prepack": "npm run build",
    "test:package": "node tools/verify-package.mjs",
    "build:examples": "vite build examples/dom --outDir ../../demo-dist/dom && vite build examples/react --outDir ../../demo-dist/react"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "fontkit": "^2.0.4",
    "pngjs": "^7.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "prosemirror-commands": "^1.7.2",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.12",
    "prosemirror-state": "^1.4.4",
    "prosemirror-view": "^1.42.6"
  },
  "sideEffects": [
    "**/*.css"
  ]
}
