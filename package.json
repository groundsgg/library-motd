{
  "name": "@groundsgg/motd",
  "version": "0.1.1",
  "description": "Standalone Minecraft Java server-list editor and preview with inline editing, MiniMessage, DOM and React adapters.",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist",
    "assets",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "docs/api.md",
    "docs/formats.md",
    "docs/embedding.md",
    "docs/profiles.md",
    "docs/limitations.md",
    "docs/browser-verification.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./dom": {
      "types": "./dist/dom/index.d.ts",
      "import": "./dist/dom/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "build": "tsc && node tools/build-assets.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "dev": "vite --host 127.0.0.1",
    "prepack": "npm run build",
    "test:package": "node tools/verify-package.mjs",
    "build:examples": "vite build examples/dom --outDir ../../demo-dist/dom && vite build examples/react --outDir ../../demo-dist/react",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:node": "node --test tests/package/*.test.mjs",
    "test:release": "node --test tests/tooling/*.test.mjs"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@fontsource-variable/manrope": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fontkit": "^2.0.4",
    "globals": "17.13.0",
    "pngjs": "^7.0.0",
    "prettier": "3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "prosemirror-commands": "^1.7.2",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.12",
    "prosemirror-state": "^1.4.4",
    "prosemirror-view": "^1.42.6"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/groundsgg/library-motd.git"
  },
  "homepage": "https://github.com/groundsgg/library-motd#readme",
  "bugs": {
    "url": "https://github.com/groundsgg/library-motd/issues"
  },
  "keywords": [
    "minecraft",
    "minecraft-java",
    "motd",
    "server-list",
    "minimessage",
    "editor",
    "typescript",
    "react"
  ],
  "engines": {
    "node": ">=22.14.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
